{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Todas las pruebas",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["test", "main", "-v", "2"],
      "django": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Rendimiento y concurrencia",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["test", "main.tests.RendimientoTests", "main.tests.ConcurrenciaTests", "-v", "2"],
      "django": true,
      "console": "integratedTerminal"
    }
  ]
}